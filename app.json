{
  "expo": {
    "name": "datu",
    "slug": "datu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/datu-icon.png",
    "scheme": "datu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.datu",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/datu-icon-512.png",
        "backgroundColor": "#221B38"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/datu-splash.png",
          "resizeMode": "center",
          "backgroundColor": "#221B38",
          "dark": {
            "image": "./assets/images/datu-icon.png",
            "backgroundColor": "#221B38"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
	"updates": {
      "enabled": true,
      "channel": "production"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cbc5e60-8d62-4d91-af30-bc9b2792a85f"
      }
    }
  }
}
